# Descriptor para makerom -> client.cia
# Basado en la plantilla RSF estandar de homebrew. Lo critico para ESTA app esta
# en ServiceAccessControl: soc:U (red), ndm:u + ac:u (WiFi), y2r:u (conversion YUV).
# Si quitas alguno, esa llamada fallara en runtime.

BasicInfo:
  Title                   : 3DSStream
  CompanyCode             : "00"
  ProductCode             : CTR-P-3DST
  Logo                    : Homebrew

TitleInfo:
  Category                : Application
  UniqueId                : 0xff3ff          # rango de homebrew

Option:
  UseOnSD                 : true
  FreeProductCode         : true
  MediaFootPadding        : false
  EnableCompress          : true
  EnableCrc               : false

AccessControlInfo:
  CoreVersion                   : 2
  DescVersion                   : 2

  # Kernel minimo (4.5.0)
  ReleaseKernelMajor            : "02"
  ReleaseKernelMinor            : "33"

  UseExtSaveData                : false

  # Permisos de acceso a FS (lista estandar de homebrew)
  FileSystemAccess:
   - CategorySystemApplication
   - CategoryHardwareCheck
   - CategoryFileSystemTool
   - Debug
   - TwlCardBackup
   - TwlNandData
   - Boss
   - DirectSdmc
   - Core
   - CtrNandRo
   - CtrNandRw
   - CtrNandRoWrite
   - CategorySystemSettings
   - SystemSaveData
   - CardBoard
   - ExportImportIvs
   - DirectSdmcWrite
   - SwitchCleanup
   - SaveDataMove
   - Shop
   - Shell
   - CategoryHomeMenu

  # Ajustes de proceso
  MemoryType                    : Application
  SystemMode                    : 64MB        # Old 3DS
  IdealProcessor                : 0
  AffinityMask                  : 1
  Priority                      : 16
  MaxCpu                        : 0x9E
  HandleTableSize               : 0x200
  DisableDebug                  : false
  EnableForceDebug              : false
  CanWriteSharedPage            : true
  CanUsePrivilegedPriority      : false
  CanUseNonAlphabetAndNumber    : true
  PermitMainFunctionArgument    : true
  CanShareDeviceMemory          : true
  RunnableOnSleep               : false
  SpecialMemoryArrange          : true

  # Exclusivo New 3DS
  SystemModeExt                 : Legacy       # usa el SystemMode de Old 3DS
  CpuSpeed                      : 268MHz
  EnableL2Cache                 : false
  CanAccessCore2                : true

  # Servicios accesibles por la app
  ServiceAccessControl:
   - APT:U
   - ac:u
   - $hioFIO
   - $hostio0
   - $hostio1
   - cfg:u
   - csnd:SND
   - dsp::DSP
   - fs:USER
   - gsp::Gpu
   - hid:USER
   - http:C
   - ir:USER
   - ir:rst
   - ir:u
   - ldr:ro
   - mic:u
   - ndm:u
   - news:u
   - ns:s
   - nwm::UDS
   - ptm:u
   - pxi:dev
   - soc:U
   - ssl:C
   - y2r:u

  IORegisterMapping:
   - 1ff50000-1ff57fff
   - 1ff70000-1ff77fff
  MemoryMapping:
   - 1f000000-1f5fffff:r

SystemControlInfo:
  SaveDataSize: 0KB
  RemasterVersion: 0
  StackSize: 0x40000

  # Modulos de sistema de los que dependen los servicios de arriba
  Dependency:
    ac: 0x0004013000002402
    am: 0x0004013000001502
    boss: 0x0004013000003402
    camera: 0x0004013000001602
    cecd: 0x0004013000002602
    cfg: 0x0004013000001702
    codec: 0x0004013000001802
    csnd: 0x0004013000002702
    dlp: 0x0004013000002802
    dsp: 0x0004013000001a02
    friends: 0x0004013000003202
    gpio: 0x0004013000001b02
    gsp: 0x0004013000001c02
    hid: 0x0004013000001d02
    http: 0x0004013000002902
    i2c: 0x0004013000001e02
    ir: 0x0004013000003302
    mcu: 0x0004013000001f02
    mic: 0x0004013000002002
    ndm: 0x0004013000002b02
    news: 0x0004013000003502
    nim: 0x0004013000002c02
    nwm: 0x0004013000002d02
    pdn: 0x0004013000002102
    ps: 0x0004013000003102
    ptm: 0x0004013000002202
    ro: 0x0004013000003702
    socket: 0x0004013000002e02
    spi: 0x0004013000002302
    ssl: 0x0004013000002f02
